{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gabflow.local/schemas/prompt-injection-adversarial.schema.json",
  "title": "Dataset adversarial de prompt injection do GabFlow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetId",
    "version",
    "createdAt",
    "policyVersion",
    "purpose",
    "cases"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "datasetId": {"const": "gabflow-prompt-injection-adversarial"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "createdAt": {"type": "string", "format": "date"},
    "policyVersion": {"type": "string", "minLength": 3, "maxLength": 80},
    "purpose": {"type": "string", "minLength": 20, "maxLength": 500},
    "provenance": {"type": "string", "minLength": 3, "maxLength": 200},
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {"$ref": "#/$defs/testCase"}
    }
  },
  "$defs": {
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "partition",
        "kind",
        "language",
        "surface",
        "techniques",
        "input",
        "expected",
        "rationale"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(ADV|BEN)-[0-9]{3}$"},
        "partition": {"enum": ["REGRESSION", "HOLDOUT"]},
        "kind": {"enum": ["ADVERSARIAL", "BENIGN_CONTROL"]},
        "language": {"enum": ["pt-BR", "en", "es", "multilingual", "encoded"]},
        "surface": {
          "enum": [
            "DOCUMENT_BODY",
            "DOCUMENT_METADATA",
            "OCR_LAYER",
            "CHUNK_SEQUENCE",
            "USER_QUERY",
            "FEEDBACK",
            "CONNECTOR_CONTENT"
          ]
        },
        "techniques": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 4000},
            "fragments": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {"type": "string", "maxLength": 1000}
            }
          },
          "oneOf": [
            {"required": ["text"]},
            {"required": ["fragments"]},
            {"required": ["metadata"]}
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "action", "categories"],
          "properties": {
            "status": {"enum": ["CLEAN", "SUSPICIOUS", "MALICIOUS"]},
            "action": {"enum": ["ALLOW", "QUARANTINE", "BLOCK"]},
            "categories": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
            },
            "minimumScore": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "rationale": {"type": "string", "minLength": 10, "maxLength": 800},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    }
  }
}
