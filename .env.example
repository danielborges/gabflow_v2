APP_ENV=development
APP_RELEASE=local
WEB_PORT=8080

POSTGRES_DB=gabflow
POSTGRES_USER=gabflow
POSTGRES_PASSWORD=troque-esta-senha-do-banco
APP_DB_USER=gabflow_app
APP_DB_PASSWORD=troque-esta-senha-da-api
WORKER_DB_USER=gabflow_worker
WORKER_DB_PASSWORD=troque-esta-senha-do-worker
BACKUP_DB_USER=gabflow_backup
BACKUP_DB_PASSWORD=troque-esta-senha-do-backup
DB_ENFORCE_RUNTIME_ROLE=true

SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes
JWT_SECRET_KEY=gere-outra-chave-aleatoria-com-pelo-menos-32-bytes
COOKIE_SECURE=false

SEED_ADMIN_ON_START=true
SEED_TENANT=gabinete-demo
SEED_ADMIN_EMAIL=admin@gabflow.local
SEED_ADMIN_PASSWORD=troque-esta-senha-administrativa
SEED_PLATFORM_ADMIN_ON_START=false
SEED_PLATFORM_ADMIN_EMAIL=platform@gabflow.local
SEED_PLATFORM_ADMIN_PASSWORD=

SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_GOOGLE_MAPS_API_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=GabFlow <atendimento@envios.seudominio.gov.br>
RESEND_TIMEOUT_SECONDS=10
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE_SECONDS=300
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=3600
WORKER_LOCK_TIMEOUT_SECONDS=300
SCHEDULER_INTERVAL_SECONDS=30

AI_TRIAGE_PROVIDER=ollama
AI_TRIAGE_MODEL=qwen2.5:3b
AI_TRIAGE_FALLBACK_MODEL=gabflow-triage-rules-v1
AI_TRIAGE_PROMPT_VERSION=triage-v3
AI_TRIAGE_TIMEOUT_SECONDS=120
AI_TRIAGE_FALLBACK_ENABLED=true
AI_ASSISTANCE_PROVIDER=ollama
AI_ASSISTANCE_MODEL=qwen2.5:3b
AI_ASSISTANCE_FALLBACK_MODEL=gabflow-assistance-rules-v1
AI_ASSISTANCE_PROMPT_VERSION=assistance-v1
AI_ASSISTANCE_TIMEOUT_SECONDS=120
AI_ASSISTANCE_FALLBACK_ENABLED=true
AI_LEGISLATIVE_PROVIDER=ollama
AI_LEGISLATIVE_MODEL=qwen2.5:3b
AI_LEGISLATIVE_FALLBACK_MODEL=gabflow-legislative-rules-v1
AI_LEGISLATIVE_PROMPT_VERSION=legislative-v1
AI_LEGISLATIVE_TIMEOUT_SECONDS=120
AI_LEGISLATIVE_FALLBACK_ENABLED=true
AI_DUPLICATE_PROVIDER=ollama
AI_EMBEDDING_MODEL=nomic-embed-text
AI_DUPLICATE_WINDOW_DAYS=180
AI_DUPLICATE_SCORE_THRESHOLD=0.72
AI_DUPLICATE_MAX_SUGGESTIONS=5
AI_DUPLICATE_CANDIDATE_LIMIT=100
AI_PRECEDENT_PROVIDER=ollama
AI_PRECEDENT_SCORE_THRESHOLD=0.60
AI_PRECEDENT_MAX_RESULTS=10
AI_PRECEDENT_CANDIDATE_LIMIT=200
AI_FOUNDATION_PROVIDER=ollama
AI_FOUNDATION_SCORE_THRESHOLD=0.55
AI_FOUNDATION_MAX_RESULTS=5
AI_FOUNDATION_CANDIDATE_LIMIT=200
AUDIO_TRANSCRIPTION_PROVIDER=faster-whisper
AUDIO_TRANSCRIPTION_MODEL=base
AUDIO_TRANSCRIPTION_DEVICE=cpu
AUDIO_TRANSCRIPTION_COMPUTE_TYPE=int8
AUDIO_TRANSCRIPTION_LANGUAGE=pt
AUDIO_TRANSCRIPTION_CACHE_DIR=/models/whisper
AUDIO_TRANSCRIPTION_MAX_DURATION_SECONDS=900
DOCUMENT_OCR_PROVIDER=tesseract
DOCUMENT_OCR_MODEL=tesseract-5
DOCUMENT_OCR_LANGUAGE=por
DOCUMENT_OCR_MAX_PAGES=25
DOCUMENT_OCR_MAX_PIXELS=25000000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=10m

MAX_ATTACHMENT_BYTES=15728640
ATTACHMENT_TOKEN_MAX_AGE=300
RAG_MAX_DOCUMENT_BYTES=26214400
RAG_DOWNLOAD_TOKEN_MAX_AGE=300
RAG_ALLOW_LEGACY_STORAGE_KEYS=true
RAG_EMBEDDING_PROVIDER=ollama
RAG_INGESTION_TIMEOUT_SECONDS=120
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150
RAG_MIN_TEXT_CHARS=20
RAG_OPERATIONAL_MEMORY_ENABLED=true
RAG_RETRIEVAL_MAX_RESULTS=5
# Pool mantido somente depois do score; não limita documentos por recência.
RAG_RETRIEVAL_CANDIDATE_LIMIT=200
RAG_RETRIEVAL_SCAN_BATCH_SIZE=500
RAG_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
RAG_RETRIEVAL_SCORE_THRESHOLD=0.28
RAG_RETRIEVAL_MIN_EVIDENCE_SCORE=0.42
RAG_RETRIEVAL_AUTHORITY_RERANK_WEIGHT=0.03
RAG_RETRIEVAL_FRESHNESS_RERANK_WEIGHT=0.01
RAG_SLO_QUERY_P95_MS=15000
RAG_SLO_QUEUE_MAX_AGE_SECONDS=300
RAG_METRICS_WINDOW_HOURS=24
RAG_THEMATIC_MIN_GROUP_SIZE=3
METRICS_BEARER_TOKEN=change-me-with-a-long-random-token
LOG_FORMAT=json
WORKER_QUEUE=default
